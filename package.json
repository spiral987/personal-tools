{
  "name": "personal-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/run-apps.mjs dev",
    "build": "pnpm --filter @personal-tools/recall --filter @personal-tools/sketchbook --filter @personal-tools/collect --filter @personal-tools/atlas build",
    "start": "node scripts/run-apps.mjs start",
    "typecheck": "pnpm --filter @personal-tools/recall --filter @personal-tools/sketchbook --filter @personal-tools/collect --filter @personal-tools/atlas typecheck",
    "test": "node --experimental-strip-types --import ./tests/vault-setup.ts --test --test-concurrency=3 tests/*.test.ts",
    "dev:recall": "pnpm --filter @personal-tools/recall dev",
    "dev:sketchbook": "pnpm --filter @personal-tools/sketchbook dev",
    "dev:gateway": "node scripts/gateway.mjs",
    "start:gateway": "node scripts/gateway.mjs",
    "dev:atlas": "pnpm --filter @personal-tools/atlas dev",
    "atlas:worker": "node --env-file-if-exists=apps/atlas/.env.local --experimental-strip-types scripts/atlas-worker.ts",
    "atlas:evaluate": "node --experimental-strip-types scripts/evaluate-atlas.ts",
    "dev:collect": "pnpm --filter @personal-tools/collect dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
