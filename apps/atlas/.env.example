# Recallと同じSupabase project。秘密鍵をNEXT_PUBLIC_へ設定しない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 任意。モデル名は利用可能な正確なIDを設定。初期値では送信しない。
ATLAS_AI_ENABLED=false
OPENAI_API_KEY=
ATLAS_VISION_MODEL=
ATLAS_EMBEDDING_MODEL=
# worker専用のSupabase service_role/secret key。ブラウザには渡さない。
ATLAS_WORKER_SECRET=
